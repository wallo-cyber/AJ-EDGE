+-- تعريب النصوص التلقائية لتأهيل الشركات (qualification_status/qualification_reason/contracting_angle/next_action)
+-- كانت الدالة تُنتج هذه القيم بالإنجليزية. نعيد تعريفها بنفس المنطق تمامًا لكن بنصوص عربية،
+-- ثم نعيد تشغيلها على كل الشركات الحالية لتحديث القيم القديمة فورًا.
+create or replace function aj_agents.refresh_company_qualification(p_company uuid)
+returns void
+language plpgsql
+security definer
+set search_path = ''
+as $$
+declare
+  v_qualification text;
+  v_reason text;
+  v_angle text;
+  v_next text;
+begin
+  select
+    case
+      when c.status in ('مرفوض', 'Rejected') then 'غير ذات صلة'
+      when c.priority = 'A' and c.lead_score >= 80 then 'مستهدفة'
+      when c.priority in ('A', 'B') and c.data_completeness >= 45 then 'محتملة'
+      when c.priority = 'C' then 'أولوية منخفضة'
+      else 'تحتاج بحث'
+    end,
+    case
+      when c.status in ('مرفوض', 'Rejected') then 'مُعلّمة كغير ذات صلة من قبل المستخدم'
+      when c.priority = 'A' and c.lead_score >= 80 then 'ملاءمة عالية بناءً على درجة التأهيل والقطاع والأولوية المحفوظة'
+      when c.priority in ('A', 'B') and c.data_completeness >= 45 then 'شركة مستهدفة ذات بيانات كافية محفوظة'
+      when c.priority = 'C' then 'ملاءمة حالية منخفضة بناءً على درجة التأهيل المحفوظة'
+      else 'تحتاج بيانات شركة موثقة أكثر قبل التأهيل'
+    end,
+    case
+      when lower(coalesce(c.company_type, '')) similar to '%(main contractor|مقاول رئيسي)%' then 'باقات مقاولات من الباطن وأعمال متخصصة'
+      when lower(coalesce(c.company_type, '')) similar to '%(real estate|developer|مطور)%' then 'تسجيل كمقاول وباقات تطوير قادمة'
+      when lower(coalesce(c.company_type, '')) similar to '%(factory|industrial|مصنع|صناعي)%' then 'أعمال مدنية صناعية وتوسعات وصيانة'
+      else 'مقاولات عامة وتسجيل كمورد'
+    end,
+    case
+      when c.data_completeness < 70 then 'استكمال بيانات الشركة الناقصة عبر بحث يدوي'
+      when not exists (select 1 from public.contacts x where x.company_id = c.id) then 'تحديد صانع القرار المناسب والتحقق منه'
+      when nullif(trim(c.vendor_registration_url), '') is null then 'مراجعة خيارات تسجيل المورد أو المقاول الرسمية'
+      else 'مراجعة مسودة التواصل الجاهزة واعتمادها يدويًا'
+    end
+  into v_qualification, v_reason, v_angle, v_next
+  from public.companies c where c.id = p_company;
+
+  update public.companies
+  set qualification_status = v_qualification,
+      qualification_reason = v_reason,
+      contracting_angle = v_angle,
+      next_action = v_next,
+      updated_at = now()
+  where id = p_company
+    and (qualification_status, qualification_reason, contracting_angle, next_action)
+      is distinct from (v_qualification, v_reason, v_angle, v_next);
+end;
+$$;
+
+revoke execute on function aj_agents.refresh_company_qualification(uuid) from public, anon, authenticated;
+
+-- إعادة تشغيل الدالة على كل الشركات الحالية لتحديث القيم القديمة بالإنجليزية فورًا
+do $$
+declare r record;
+begin
+  for r in select id from public.companies loop
+    perform aj_agents.refresh_company_qualification(r.id);
+  end loop;
+end $$;
+
+-- تصحيح تراكمي لبيانات قديمة كُتبت مرة واحدة بالإنجليزية (score_reasons/missing_fields/data_quality_status/outreach_status)
+-- هذه أعمدة عرض فقط، لا يعتمد عليها أي منطق آخر بالتطبيق، فآمن إعادة توليدها هنا.
+update public.companies set score_reasons = jsonb_build_array(
+  'نوع الشركة: ' || (case company_type
+    when 'Factory' then 'مصنع' when 'Industrial Company' then 'شركة صناعية'
+    when 'Main Contractor' then 'مقاول رئيسي' when 'Real Estate Developer' then 'مطور عقاري'
+    when 'Other' then 'أخرى' else coalesce(nullif(company_type,''),'غير محدد') end),
+  'الموقع: ' || (case city
+    when 'Dammam' then 'الدمام' when 'Khobar' then 'الخبر' when 'Dhahran' then 'الظهران'
+    when 'Jubail' then 'الجبيل' when 'Ras Tanura' then 'رأس تنورة' when 'Qatif' then 'القطيف'
+    else coalesce(nullif(city,''),'غير محدد') end),
+  case when website<>'' or coalesce(nullif(general_phone,''),nullif(phone,'')) is not null or coalesce(nullif(general_email,''),nullif(email,'')) is not null
+    then 'تتوفر قناة تواصل' else 'بيانات التواصل تحتاج إثراء' end,
+  case when contact_person<>'' then 'صانع القرار متوفر' else 'يحتاج بحث عن صانع القرار' end
+)
+where score_reasons is not null and jsonb_array_length(score_reasons) > 0;
+
+update public.companies set missing_fields = (
+  select array_agg(case elem
+    when 'website' then 'الموقع الإلكتروني' when 'general phone' then 'هاتف عام'
+    when 'general email' then 'بريد إلكتروني عام' when 'decision maker' then 'صانع القرار'
+    when 'mobile' then 'الجوال' when 'LinkedIn' then 'لينكدإن'
+    when 'source verification' then 'توثيق المصدر' else elem end)
+  from unnest(missing_fields) as elem
+) where missing_fields is not null and array_length(missing_fields,1) > 0;
+
+update public.companies set data_quality_status = case data_quality_status
+  when 'Complete' then 'مكتملة' when 'Good' then 'جيدة'
+  when 'Needs Enrichment' then 'تحتاج إثراء' when 'Poor Data' then 'بيانات ضعيفة'
+  else data_quality_status end
+where data_quality_status is not null and data_quality_status <> '';
+
+update public.companies set outreach_status = 'لم يتم التواصل'
+where outreach_status = 'Not Contacted';
