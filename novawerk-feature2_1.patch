+      trade: (cols[1] || '').trim(),
+      contact_name: (cols[2] || '').trim(),
+      phone: (cols[3] || '').trim(),
+      email: (cols[4] || '').trim(),
+      city: (cols[5] || '').trim(),
+      scope: (cols[6] || '').trim(),
+    }))
+    .filter((r) => r.company_name);
+}
