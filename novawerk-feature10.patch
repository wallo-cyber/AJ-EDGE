+'use client';
+
+/**
+ * استيراد جهات الاتصال المصدّرة من الجوال (ملف vCard ‎.vcf‎ أو ‎CSV‎).
+ * المبدأ المطلوب من المستخدم: هذي القائمة مستقلة تمامًا ولا تتداخل مع الشركات،
+ * فتُحفظ بدون company_id، وتُربط بشركة لاحقًا فقط عند التطابق الفعلي.
+ */
+
+import { useMemo, useState } from 'react';
+import type { Contact } from '../lib/contact-store';
+import { createEmptyContact } from '../lib/contact-store';
+import { supabaseCrm } from '../lib/supabase/crm';
+
+export type ParsedContact = {
+  fullName: string;
+  mobile: string;
+  email: string;
+  organization: string;
+  position: string;
+};
+
+const digits = (value: string) => value.replace(/\D/g, '');
+
+/** توحيد رقم الجوال السعودي للمقارنة: نأخذ آخر 9 أرقام (بعد إسقاط 966/0 البادئة) */
+const phoneKey = (value: string) => {
+  const only = digits(value);
+  return only.length > 9 ? only.slice(-9) : only;
+};
+
+/** فك ترميز quoted-printable الشائع في ملفات vCard المصدّرة من أندرويد */
+function decodeQuotedPrintable(value: string) {
+  try {
+    const bytes = value
+      .replace(/=\r?\n/g, '')
+      .replace(/=([0-9A-Fa-f]{2})/g, (_m, hex) => String.fromCharCode(parseInt(hex, 16)));
+    // إعادة تفسير البايتات كـ UTF-8 حتى تظهر الأسماء العربية صحيحة
+    const arr = Uint8Array.from([...bytes].map((c) => c.charCodeAt(0) & 0xff));
+    return new TextDecoder('utf-8').decode(arr);
+  } catch {
+    return value;
+  }
+}
+
+export function parseVcf(text: string): ParsedContact[] {
+  // فك طي الأسطر: أي سطر يبدأ بمسافة أو tab هو امتداد للسطر السابق
+  const unfolded = text.replace(/\r\n/g, '\n').replace(/\n[ \t]/g, '');
+  const cards = unfolded.split(/BEGIN:VCARD/i).slice(1);
+  const out: ParsedContact[] = [];
+
+  for (const card of cards) {
+    let fullName = '';
+    let structuredName = '';
+    let mobile = '';
+    let anyPhone = '';
+    let email = '';
+    let organization = '';
+    let position = '';
+
+    for (const rawLine of card.split('\n')) {
+      const line = rawLine.trim();
+      if (!line || /^END:VCARD/i.test(line)) continue;
+      const sep = line.indexOf(':');
+      if (sep < 0) continue;
+      const head = line.slice(0, sep);
+      let body = line.slice(sep + 1).trim();
+      if (/quoted-printable/i.test(head)) body = decodeQuotedPrintable(body);
+      const key = head.split(';')[0].replace(/^item\d+\./i, '').toUpperCase();
+
+      if (key === 'FN') fullName = body;
+      else if (key === 'N' && !structuredName) {
+        const parts = body.split(';');
+        structuredName = [parts[1], parts[0]].filter(Boolean).join(' ').trim();
+      } else if (key === 'TEL') {
+        if (!anyPhone) anyPhone = body;
+        if (!mobile && /cell|mobile|جوال/i.test(head)) mobile = body;
+      } else if (key === 'EMAIL' && !email) email = body;
+      else if (key === 'ORG' && !organization) organization = body.split(';')[0].trim();
+      else if (key === 'TITLE' && !position) position = body;
+    }
+
+    const name = (fullName || structuredName).trim();
+    const phone = (mobile || anyPhone).trim();
+    if (!name && !phone) continue;
+    out.push({ fullName: name || phone, mobile: phone, email, organization, position });
+  }
+  return out;
+}
+
+/** قارئ CSV بسيط يدعم الحقول المقتبسة بعلامات تنصيص */
+function splitCsvLine(line: string) {
+  const cells: string[] = [];
+  let cur = '';
+  let quoted = false;
+  for (let i = 0; i < line.length; i += 1) {
+    const ch = line[i];
+    if (quoted) {
+      if (ch === '"' && line[i + 1] === '"') { cur += '"'; i += 1; }
+      else if (ch === '"') quoted = false;
+      else cur += ch;
+    } else if (ch === '"') quoted = true;
+    else if (ch === ',') { cells.push(cur); cur = ''; }
+    else cur += ch;
+  }
+  cells.push(cur);
+  return cells.map((c) => c.trim());
+}
+
+export function parseCsv(text: string): ParsedContact[] {
+  const lines = text.replace(/\r\n/g, '\n').split('\n').filter((l) => l.trim());
+  if (lines.length < 2) return [];
+  const headers = splitCsvLine(lines[0]).map((h) => h.toLowerCase());
+
+  const findIndex = (candidates: string[]) =>
+    headers.findIndex((h) => candidates.some((c) => h.includes(c)));
+
+  const iFull = findIndex(['full name', 'display name', 'name', 'الاسم']);
+  const iFirst = findIndex(['first name', 'given name']);
+  const iLast = findIndex(['last name', 'family name', 'surname']);
+  const iMobile = findIndex(['mobile', 'cell', 'جوال']);
+  const iPhone = findIndex(['phone', 'tel', 'هاتف', 'رقم']);
+  const iEmail = findIndex(['e-mail', 'email', 'بريد']);
+  const iOrg = findIndex(['organization', 'company', 'شركة', 'جهة']);
+  const iTitle = findIndex(['title', 'position', 'job', 'منصب']);
+
+  const pick = (cells: string[], index: number) => (index >= 0 ? (cells[index] ?? '').trim() : '');
+
+  const out: ParsedContact[] = [];
+  for (const line of lines.slice(1)) {
+    const cells = splitCsvLine(line);
+    const composed = [pick(cells, iFirst), pick(cells, iLast)].filter(Boolean).join(' ').trim();
+    const name = (pick(cells, iFull) || composed).trim();
+    const phone = (pick(cells, iMobile) || pick(cells, iPhone)).trim();
+    if (!name && !phone) continue;
+    out.push({
+      fullName: name || phone,
+      mobile: phone,
+      email: pick(cells, iEmail),
+      organization: pick(cells, iOrg),
+      position: pick(cells, iTitle),
+    });
+  }
+  return out;
+}
+
+type Props = { onClose: () => void; onImported: (added: number, skipped: number) => void };
+
+export function ContactsImport({ onClose, onImported }: Props) {
+  const [rows, setRows] = useState<ParsedContact[]>([]);
+  const [fileName, setFileName] = useState('');
+  const [skip, setSkip] = useState<Set<number>>(new Set());
+  const [busy, setBusy] = useState(false);
+  const [progress, setProgress] = useState(0);
+  const [error, setError] = useState('');
+
+  /** إزالة التكرار داخل الملف نفسه بالاعتماد على رقم الجوال ثم البريد ثم الاسم */
+  const unique = useMemo(() => {
+    const seen = new Set<string>();
+    return rows.filter((r) => {
+      const key = phoneKey(r.mobile) || r.email.toLowerCase() || r.fullName.toLowerCase();
+      if (!key || seen.has(key)) return false;
+      seen.add(key);
+      return true;
+    });
+  }, [rows]);
+
+  const selectedCount = unique.length - skip.size;
+
+  const readFile = async (file: File) => {
+    setError('');
+    setSkip(new Set());
+    setFileName(file.name);
+    try {
+      const text = await file.text();
+      const parsed = /\.csv$/i.test(file.name) ? parseCsv(text) : parseVcf(text);
+      if (!parsed.length) setError('لم يتم العثور على جهات اتصال في الملف. تأكد أنه ملف vCard ‎.vcf‎ أو ‎CSV‎ مُصدَّر من الجوال.');
+      setRows(parsed);
+    } catch {
+      setError('تعذّر قراءة الملف.');
+      setRows([]);
+    }
+  };
+
+  const runImport = async () => {
+    const list = unique.filter((_, index) => !skip.has(index));
+    if (!list.length) return;
+    setBusy(true);
+    setError('');
+    setProgress(0);
+
+    let added = 0;
+    let skipped = 0;
+    for (let i = 0; i < list.length; i += 1) {
+      const item = list[i];
+      try {
+        // بدون companyId إطلاقًا — تبقى قائمة مستقلة لا تتداخل مع الشركات
+        const payload: Partial<Contact> = {
+          ...createEmptyContact('', ''),
+          fullName: item.fullName,
+          mobile: item.mobile,
+          email: item.email,
+          position: item.position,
+          notes: item.organization ? `الجهة حسب دفتر الجوال: ${item.organization}` : '',
+          source: 'دفتر جهات اتصال الجوال',
+          verificationStatus: 'UNVERIFIED',
+        };
+        await supabaseCrm.contacts.create(payload);
+        added += 1;
+      } catch (reason) {
+        // 23505 = مكرر مسبقًا (نفس الجوال أو البريد) — نتجاوزه ونكمل بدل إيقاف الاستيراد
+        const code = (reason as { code?: string })?.code;
+        if (code === '23505') skipped += 1;
+        else {
+          setError(reason instanceof Error ? reason.message : 'تعذّر استيراد أحد السجلات.');
+          skipped += 1;
+        }
+      }
+      setProgress(i + 1);
+    }
+
+    setBusy(false);
+    onImported(added, skipped);
+  };
+
+  const toggleSkip = (index: number) =>
+    setSkip((prev) => {
+      const next = new Set(prev);
+      if (next.has(index)) next.delete(index);
+      else next.add(index);
+      return next;
+    });
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-black/60 p-4">
+      <section className="crm-card my-6 w-full max-w-3xl p-5">
+        <div className="flex items-start justify-between gap-3">
+          <div>
+            <h3 className="text-lg font-bold">استيراد جهات اتصال من الجوال</h3>
+            <p className="mt-1 text-sm text-[#75664d]">
+              تُحفظ كقائمة مستقلة بدون ربط بأي شركة. تقدر تربط أي جهة بشركة لاحقًا من زر «ربط بشركة».
+            </p>
+          </div>
+          <button onClick={onClose} className="btn-ghost shrink-0" disabled={busy}>إغلاق</button>
+        </div>
+
+        <div className="mt-4 rounded-xl border border-dashed p-4">
+          <input
+            type="file"
+            accept=".vcf,.csv,text/vcard,text/csv"
+            disabled={busy}
+            onChange={(event) => {
+              const file = event.target.files?.[0];
+              if (file) void readFile(file);
+            }}
+            className="w-full text-sm"
+          />
+          <p className="mt-2 text-xs text-[#75664d]">
+            من الآيفون: جهات الاتصال ← مشاركة جهة/تصدير ملف ‎.vcf‎. من أندرويد: تطبيق جهات الاتصال ← تصدير إلى ملف ‎.vcf‎. ملفات ‎CSV‎ من Google Contacts مدعومة أيضًا.
+          </p>
+        </div>
+
+        {error && <p className="mt-3 rounded-xl bg-red-50 p-3 text-sm text-red-700">{error}</p>}
+
+        {unique.length > 0 && (
+          <>
+            <div className="mt-4 flex flex-wrap items-center justify-between gap-2 text-sm">
+              <span>
+                {fileName} · تم العثور على <strong>{unique.length}</strong> جهة (بعد إزالة المكرر داخل الملف) ·
+                سيتم استيراد <strong>{selectedCount}</strong>
+              </span>
+              <div className="flex gap-2">
+                <button onClick={() => setSkip(new Set())} className="btn-ghost" disabled={busy}>تحديد الكل</button>
+                <button onClick={() => setSkip(new Set(unique.map((_, i) => i)))} className="btn-ghost" disabled={busy}>إلغاء الكل</button>
+              </div>
+            </div>
+
+            <div className="mt-3 max-h-80 overflow-y-auto rounded-xl border">
+              <table className="min-w-full text-right text-sm">
+                <thead className="sticky top-0">
+                  <tr>
+                    <th className="p-2"> </th>
+                    <th className="p-2">الاسم</th>
+                    <th className="p-2">الجوال</th>
+                    <th className="p-2">البريد</th>
+                    <th className="p-2">الجهة (من الجوال)</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {unique.map((row, index) => (
+                    <tr key={`${row.fullName}-${index}`} className="border-t">
+                      <td className="p-2">
+                        <input
+                          type="checkbox"
+                          checked={!skip.has(index)}
+                          onChange={() => toggleSkip(index)}
+                          disabled={busy}
+                          className="h-4 w-4"
+                        />
+                      </td>
+                      <td className="p-2 font-bold">{row.fullName}</td>
+                      <td className="p-2" dir="ltr">{row.mobile || '—'}</td>
+                      <td className="p-2" dir="ltr">{row.email || '—'}</td>
+                      <td className="p-2">{row.organization || '—'}</td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+
+            <div className="mt-4 flex flex-wrap items-center justify-between gap-3">
+              <span className="text-xs text-[#75664d]">
+                {busy ? `جارٍ الاستيراد... ${progress} من ${selectedCount}` : 'الأرقام المكررة مع جهات موجودة مسبقًا يتم تجاوزها تلقائيًا.'}
+              </span>
+              <button onClick={() => void runImport()} className="btn-primary" disabled={busy || selectedCount === 0}>
+                {busy ? 'جارٍ الاستيراد...' : `استيراد ${selectedCount} جهة`}
+              </button>
+            </div>
+          </>
+        )}
+      </section>
+    </div>
+  );
+}
